{
  "name": "dji-video-compressor",
  "version": "1.0.0",
  "description": "Compress DJI drone videos while preserving GPS metadata",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "io.projectkiwi.video-compressor",
    "productName": "DJI Video Compressor",
    "mac": {
      "target": "dmg",
      "icon": null
    },
    "files": [
      "main.js",
      "index.html",
      "node_modules/ffmpeg-static/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "keywords": [],
  "author": "Project Kiwi",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron": "^42.4.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
